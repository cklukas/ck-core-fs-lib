 namespace __tsan {
 
+#if defined(__aarch64__) && !SANITIZER_GO
+// Darwin's native errno storage is outside the generic TLS interval on arm64.
+// Keep its lifetime separate from the generic TLS/DTLS bookkeeping. A fiber
+// shares the operating-system thread's errno and must not start or retire it.
+struct NativeErrnoLifetime {
+  uptr addr;
+  uptr size;
+  bool active;
+};
+static THREADLOCAL NativeErrnoLifetime native_errno_lifetime;
+extern "C" void __tsan_native_errno_initialization() {}
+extern "C" void __tsan_native_errno_retirement() {}
+
+void NativeErrnoTlsStart(ThreadState *thr) {
+  // The main thread starts during dyld initialization, before Mach-O TLV
+  // bootstrap is available. Its initial memory is synchronized with every
+  // subsequently created thread and its native storage is never reused.
+  if (thr->tid == kMainTid || thr->tctx->thread_type == ThreadType::Fiber)
+    return;
+  CHECK(!native_errno_lifetime.active);
+  int *const storage = __error();
+  CHECK(storage);
+  const uptr pc = StackTrace::GetNextInstructionPc(
+      reinterpret_cast<uptr>(__tsan_native_errno_initialization));
+  const uptr addr = reinterpret_cast<uptr>(storage);
+  CHECK(MemoryImitateNativeTlsWrite(thr, pc, addr, sizeof(*storage)));
+  native_errno_lifetime = {addr, sizeof(*storage), true};
+}
+
+void NativeErrnoTlsFinish(ThreadState *thr) {
+  if (thr->tid == kMainTid || thr->tctx->thread_type == ThreadType::Fiber ||
+      !native_errno_lifetime.active)
+    return;
+  const uptr pc = StackTrace::GetNextInstructionPc(
+      reinterpret_cast<uptr>(__tsan_native_errno_retirement));
+  CHECK(MemoryRetireNativeTls(thr, pc, native_errno_lifetime.addr,
+                             native_errno_lifetime.size));
+  native_errno_lifetime = {};
+}
+#endif
+
 #if !SANITIZER_GO
 alignas(SANITIZER_CACHE_LINE_SIZE) static char main_thread_state[sizeof(
     ThreadState)];
