diff --git a/compiler-rt/lib/tsan/tests/unit/tsan_native_tls_test.cpp b/compiler-rt/lib/tsan/tests/unit/tsan_native_tls_test.cpp
new file mode 100644
index 00000000..87caaecd
--- /dev/null
+++ b/compiler-rt/lib/tsan/tests/unit/tsan_native_tls_test.cpp
@@ -0,0 +1,179 @@
+//===-- tsan_native_tls_test.cpp ------------------------------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Focused tests for the private native-TLS shadow lifetime primitive.
+//
+//===----------------------------------------------------------------------===//
+
+#include "tsan_mman.h"
+#include "tsan_platform.h"
+#include "tsan_rtl.h"
+#include "gtest/gtest.h"
+
+namespace __tsan {
+namespace {
+
+constexpr uptr kPc = 0;
+
+FastState TestState(Sid sid = static_cast<Sid>(17),
+                    Epoch epoch = static_cast<Epoch>(22)) {
+  FastState state;
+  state.SetSid(sid);
+  state.SetEpoch(epoch);
+  return state;
+}
+
+void ResetTestRange(ThreadState *thr, uptr addr, uptr size) {
+  MemoryResetRange(thr, kPc, addr, size);
+}
+
+bool HasAccess(uptr addr, Sid sid, Epoch epoch, uptr expected_offset,
+               uptr expected_size, AccessType expected_type) {
+  RawShadow *shadow_mem = MemToShadow(RoundDown(addr, kShadowCell));
+  for (uptr i = 0; i < kShadowCnt; ++i) {
+    Shadow shadow(LoadShadow(&shadow_mem[i]));
+    if (shadow.sid() != sid || shadow.epoch() != epoch)
+      continue;
+    uptr offset = 0;
+    uptr size = 0;
+    AccessType type = 0;
+    shadow.GetAccess(&offset, &size, &type);
+    if (offset == expected_offset && size == expected_size &&
+        type == expected_type)
+      return true;
+  }
+  return false;
+}
+
+bool CellIsEmpty(uptr addr) {
+  RawShadow *shadow_mem = MemToShadow(RoundDown(addr, kShadowCell));
+  for (uptr i = 0; i < kShadowCnt; ++i) {
+    if (LoadShadow(&shadow_mem[i]) != Shadow::kEmpty)
+      return false;
+  }
+  return true;
+}
+
+void StoreCellSlot(uptr addr, uptr slot, RawShadow raw) {
+  RawShadow *shadow_mem = MemToShadow(RoundDown(addr, kShadowCell));
+  StoreShadow(&shadow_mem[slot], raw);
+}
+
+RawShadow MalformedMask(RawShadow raw, u8 access_mask) {
+#if __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
+  constexpr uptr kAccessShift = 0;
+#else
+  constexpr uptr kAccessShift = 24;
+#endif
+  u32 value = static_cast<u32>(raw);
+  value &= ~(0xffu << kAccessShift);
+  value |= static_cast<u32>(access_mask) << kAccessShift;
+  return static_cast<RawShadow>(value);
+}
+
+TEST(NativeTlsShadow, ExactMasksAllOffsetsAndSizes) {
+  ThreadState *thr = cur_thread();
+  char *storage = static_cast<char *>(user_alloc(thr, kPc, 64));
+  ASSERT_NE(storage, nullptr);
+  const Sid sid = thr->fast_state.sid();
+  const Epoch epoch = thr->fast_state.epoch();
+
+  for (uptr size : {1U, 2U, 4U}) {
+    for (uptr offset = 0; offset < kShadowCell; ++offset) {
+      ResetTestRange(thr, reinterpret_cast<uptr>(storage), 64);
+      const uptr addr = reinterpret_cast<uptr>(storage) + offset;
+      ASSERT_TRUE(MemoryImitateNativeTlsWrite(thr, kPc, addr, size));
+
+      const uptr first = Min(size, kShadowCell - offset % kShadowCell);
+      ASSERT_TRUE(HasAccess(addr, sid, epoch, offset % kShadowCell, first,
+                            kAccessWrite));
+      if (first != size) {
+        ASSERT_TRUE(HasAccess(addr + first, sid, epoch, 0, size - first,
+                              kAccessWrite));
+      }
+
+      ASSERT_TRUE(MemoryRetireNativeTls(thr, kPc, addr, size));
+      ASSERT_TRUE(CellIsEmpty(addr));
+      if (first != size)
+        ASSERT_TRUE(CellIsEmpty(addr + first));
+    }
+  }
+
+  // This is the explicit cross-cell boundary case (offset 7, size 4).
+  ResetTestRange(thr, reinterpret_cast<uptr>(storage), 64);
+  const uptr boundary =
+      RoundDown(reinterpret_cast<uptr>(storage), kShadowCell) + 7;
+  ASSERT_TRUE(MemoryImitateNativeTlsWrite(thr, kPc, boundary, 4));
+  ASSERT_TRUE(HasAccess(boundary, sid, epoch, 7, 1, kAccessWrite));
+  ASSERT_TRUE(HasAccess(boundary + 1, sid, epoch, 0, 3, kAccessWrite));
+  ASSERT_TRUE(MemoryRetireNativeTls(thr, kPc, boundary, 4));
+  ASSERT_TRUE(CellIsEmpty(boundary));
+  ASSERT_TRUE(CellIsEmpty(boundary + 1));
+
+  user_free(thr, kPc, storage);
+}
+
+TEST(NativeTlsShadow, NeighborHistoryIsRetained) {
+  ThreadState *thr = cur_thread();
+  char *storage = static_cast<char *>(user_alloc(thr, kPc, 32));
+  ASSERT_NE(storage, nullptr);
+  const uptr addr = reinterpret_cast<uptr>(storage) + 4;
+  ResetTestRange(thr, reinterpret_cast<uptr>(storage), 32);
+
+  Shadow neighbor(TestState(), 0, 2, kAccessWrite);
+  StoreCellSlot(addr, 0, neighbor.raw());
+  ASSERT_TRUE(MemoryImitateNativeTlsWrite(thr, kPc, addr, 2));
+  RawShadow *shadow_mem = MemToShadow(RoundDown(addr, kShadowCell));
+  ASSERT_EQ(LoadShadow(&shadow_mem[0]), neighbor.raw());
+  ASSERT_TRUE(MemoryRetireNativeTls(thr, kPc, addr, 2));
+  ASSERT_EQ(LoadShadow(&shadow_mem[0]), neighbor.raw());
+
+  user_free(thr, kPc, storage);
+}
+
+void CheckRejectedShadow(RawShadow raw) {
+  ThreadState *thr = cur_thread();
+  char *storage = static_cast<char *>(user_alloc(thr, kPc, 16));
+  ASSERT_NE(storage, nullptr);
+  const uptr addr = reinterpret_cast<uptr>(storage);
+  ResetTestRange(thr, addr, 16);
+  StoreCellSlot(addr, 0, raw);
+  ASSERT_FALSE(MemoryImitateNativeTlsWrite(thr, kPc, addr, 1));
+  ASSERT_EQ(LoadShadow(MemToShadow(addr)), raw);
+  ASSERT_FALSE(MemoryRetireNativeTls(thr, kPc, addr, 1));
+  ASSERT_EQ(LoadShadow(MemToShadow(addr)), raw);
+  user_free(thr, kPc, storage);
+}
+
+TEST(NativeTlsShadow, RejectsMalformedRodataAndFreedMarkers) {
+  FastState state = TestState();
+  Shadow ordinary(state, 0, 8, kAccessWrite);
+  CheckRejectedShadow(MalformedMask(ordinary.raw(), 0x05));
+  CheckRejectedShadow(Shadow::kRodata);
+  CheckRejectedShadow(Shadow::FreedMarker());
+  CheckRejectedShadow(Shadow::FreedInfo(state.sid(), state.epoch()));
+}
+
+TEST(NativeTlsShadow, RejectsNonContiguousResidualFreedMask) {
+  ThreadState *thr = cur_thread();
+  char *storage = static_cast<char *>(user_alloc(thr, kPc, 16));
+  ASSERT_NE(storage, nullptr);
+  const uptr addr = reinterpret_cast<uptr>(storage) + 1;
+  ResetTestRange(thr, reinterpret_cast<uptr>(storage), 16);
+
+  Shadow full(TestState(), 0, kShadowCell, kAccessWrite);
+  StoreCellSlot(addr, 0, full.raw());
+  const RawShadow before = LoadShadow(MemToShadow(addr));
+  ASSERT_FALSE(MemoryRetireNativeTls(thr, kPc, addr, 6));
+  ASSERT_EQ(LoadShadow(MemToShadow(addr)), before);
+
+  user_free(thr, kPc, storage);
+}
+
+}  // namespace
+}  // namespace __tsan
diff --git a/compiler-rt/test/tsan/native_errno_tls.cpp b/compiler-rt/test/tsan/native_errno_tls.cpp
new file mode 100644
index 00000000..1dedcca9
--- /dev/null
+++ b/compiler-rt/test/tsan/native_errno_tls.cpp
@@ -0,0 +1,123 @@
+// RUN: %clangxx_tsan %darwin_min_target_with_tls_support -pthread -O1 -g %s -o %t
+// RUN: %run %t detached 2>&1 | FileCheck %s --check-prefix=DETACHED
+// RUN: %run %t joined 2>&1 | FileCheck %s --check-prefix=JOINED
+// RUN: %run %t shared 2>&1 | FileCheck %s --check-prefix=SHARED
+// REQUIRES: system-darwin
+//
+// Exercises native errno lifetime registration without suppressing a genuine
+// race through a foreign pointer into another thread's errno object.
+
+#include <atomic>
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <pthread.h>
+#include <sched.h>
+#include <vector>
+
+namespace {
+
+constexpr int kWorkerCount = 1000;
+std::atomic<int> completed;
+
+void *ErrnoWorker(void *) {
+  errno = 0;
+  completed.fetch_add(1, std::memory_order_relaxed);
+  return nullptr;
+}
+
+int RunDetached() {
+  completed.store(0, std::memory_order_relaxed);
+  pthread_attr_t attr;
+  if (pthread_attr_init(&attr) != 0 ||
+      pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED) != 0)
+    return 2;
+  for (int i = 0; i < kWorkerCount; ++i) {
+    pthread_t thread;
+    if (pthread_create(&thread, &attr, ErrnoWorker, nullptr) != 0)
+      return 3;
+  }
+  pthread_attr_destroy(&attr);
+  while (completed.load(std::memory_order_acquire) != kWorkerCount)
+    sched_yield();
+  std::printf("DETACHED PASS\n");
+  return 0;
+}
+
+int RunJoined() {
+  completed.store(0, std::memory_order_relaxed);
+  std::vector<pthread_t> threads;
+  threads.reserve(kWorkerCount);
+  for (int i = 0; i < kWorkerCount; ++i) {
+    pthread_t thread;
+    if (pthread_create(&thread, nullptr, ErrnoWorker, nullptr) != 0)
+      return 2;
+    threads.push_back(thread);
+  }
+  for (pthread_t thread : threads) {
+    if (pthread_join(thread, nullptr) != 0)
+      return 3;
+  }
+  if (completed.load(std::memory_order_acquire) != kWorkerCount)
+    return 4;
+  std::printf("JOINED PASS\n");
+  return 0;
+}
+
+std::atomic<int *> foreign_errno;
+std::atomic<bool> shared_ready;
+std::atomic<bool> shared_go;
+
+void *SharedErrnoWorker(void *) {
+  errno = 1;
+  foreign_errno.store(&errno, std::memory_order_release);
+  shared_ready.store(true, std::memory_order_release);
+  while (!shared_go.load(std::memory_order_relaxed))
+    sched_yield();
+  // This is intentionally unordered with the main-thread write through the
+  // published pointer. It must remain reportable by TSan.
+  errno = 2;
+  return nullptr;
+}
+
+int RunShared() {
+  shared_ready.store(false, std::memory_order_relaxed);
+  shared_go.store(false, std::memory_order_relaxed);
+  foreign_errno.store(nullptr, std::memory_order_relaxed);
+  pthread_t thread;
+  if (pthread_create(&thread, nullptr, SharedErrnoWorker, nullptr) != 0)
+    return 2;
+  while (!shared_ready.load(std::memory_order_acquire))
+    sched_yield();
+  int *foreign = foreign_errno.load(std::memory_order_acquire);
+  if (!foreign)
+    return 3;
+  *foreign = 3;
+  shared_go.store(true, std::memory_order_relaxed);
+  if (pthread_join(thread, nullptr) != 0)
+    return 4;
+  std::printf("SHARED PASS\n");
+  return 0;
+}
+
+}  // namespace
+
+int main(int argc, char **argv) {
+  if (argc != 2)
+    return 1;
+  if (std::strcmp(argv[1], "detached") == 0)
+    return RunDetached();
+  if (std::strcmp(argv[1], "joined") == 0)
+    return RunJoined();
+  if (std::strcmp(argv[1], "shared") == 0)
+    return RunShared();
+  return 1;
+}
+
+// DETACHED-NOT: ThreadSanitizer: data race
+// DETACHED: DETACHED PASS
+// JOINED-NOT: ThreadSanitizer: data race
+// JOINED: JOINED PASS
+// SHARED: ThreadSanitizer: data race
+// SHARED: SHARED PASS
diff --git a/compiler-rt/test/tsan/libdispatch/native_errno_gcd.cpp b/compiler-rt/test/tsan/libdispatch/native_errno_gcd.cpp
new file mode 100644
index 00000000..d4dab053
--- /dev/null
+++ b/compiler-rt/test/tsan/libdispatch/native_errno_gcd.cpp
@@ -0,0 +1,103 @@
+// RUN: %clangxx_tsan %darwin_min_target_with_tls_support -O1 -g %s -o %t
+// RUN: %run %t gcd 2>&1 | FileCheck %s --check-prefix=GCD
+// RUN: %run %t main-foreign 2>&1 | FileCheck %s --check-prefix=MAIN
+// REQUIRES: libdispatch
+// REQUIRES: system-darwin
+//
+// GCD workers are created without an observable pthread_create call. The gcd
+// mode exercises that startup path and repeated dispatch errno use. The main-
+// foreign mode checks that ordinary instrumentation still reports a worker
+// writing through a pointer to the main thread's errno object, even though
+// main-thread errno lifetime registration is intentionally excluded.
+
+#include <atomic>
+#include <cerrno>
+#include <cstdio>
+#include <cstring>
+#include <dispatch/dispatch.h>
+#include <sched.h>
+
+namespace {
+
+constexpr int kRounds = 16;
+constexpr int kTasksPerRound = 128;
+
+std::atomic<int> gcd_started;
+
+int RunGcdErrnoReuse() {
+  dispatch_queue_t queue =
+      dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0);
+
+  // The first task is held long enough to force libdispatch to start a worker
+  // before the rest of the batch is released. Subsequent rounds exercise
+  // worker/errno storage reuse without sharing any errno object between
+  // tasks.
+  for (int round = 0; round < kRounds; ++round) {
+    gcd_started.store(0, std::memory_order_relaxed);
+    dispatch_group_t group = dispatch_group_create();
+    dispatch_semaphore_t release = dispatch_semaphore_create(0);
+    for (int i = 0; i < kTasksPerRound; ++i) {
+      dispatch_group_async(group, queue, ^{
+        errno = 0;
+        gcd_started.fetch_add(1, std::memory_order_relaxed);
+        dispatch_semaphore_wait(release, DISPATCH_TIME_FOREVER);
+      });
+    }
+    while (gcd_started.load(std::memory_order_acquire) == 0)
+      sched_yield();
+    for (int i = 0; i < kTasksPerRound; ++i)
+      dispatch_semaphore_signal(release);
+    dispatch_group_wait(group, DISPATCH_TIME_FOREVER);
+  }
+
+  std::printf("GCD PASS rounds=%d\n", kRounds);
+  return 0;
+}
+
+std::atomic<bool> main_foreign_ready;
+std::atomic<bool> main_foreign_go;
+
+int RunMainForeignErrnoRace() {
+  main_foreign_ready.store(false, std::memory_order_relaxed);
+  main_foreign_go.store(false, std::memory_order_relaxed);
+  int *const main_errno = &errno;
+  dispatch_group_t group = dispatch_group_create();
+  dispatch_queue_t queue =
+      dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0);
+
+  dispatch_group_async(group, queue, ^{
+    // This is the worker's own errno and exercises its native lifetime
+    // registration before the deliberate foreign-pointer access below.
+    errno = 1;
+    main_foreign_ready.store(true, std::memory_order_release);
+    while (!main_foreign_go.load(std::memory_order_relaxed))
+      sched_yield();
+    // Intentionally unordered with the main-thread write below.
+    *main_errno = 2;
+  });
+
+  while (!main_foreign_ready.load(std::memory_order_acquire))
+    sched_yield();
+  *main_errno = 3;
+  main_foreign_go.store(true, std::memory_order_relaxed);
+  dispatch_group_wait(group, DISPATCH_TIME_FOREVER);
+  std::printf("MAIN FOREIGN PASS\n");
+  return 0;
+}
+
+}  // namespace
+
+int main(int argc, char **argv) {
+  if (argc != 2)
+    return 1;
+  if (std::strcmp(argv[1], "gcd") == 0)
+    return RunGcdErrnoReuse();
+  if (std::strcmp(argv[1], "main-foreign") == 0)
+    return RunMainForeignErrnoRace();
+  return 1;
+}
+
+// GCD-NOT: ThreadSanitizer: data race
+// GCD: GCD PASS rounds=16
+// MAIN: ThreadSanitizer: data race
+// MAIN: MAIN FOREIGN PASS
