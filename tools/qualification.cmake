# Run with cmake -DQUALIFICATION_OUTPUT=<fresh absolute directory> -P tools/qualification.cmake.
cmake_minimum_required(VERSION 3.25)
get_filename_component(source "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(CMAKE_HOST_APPLE)
  execute_process(COMMAND /sbin/mount OUTPUT_VARIABLE mounts COMMAND_ERROR_IS_FATAL ANY)
  set(temp_roots "")
  foreach(volume S8T PRO-BLADE)
    if(mounts MATCHES " on /Volumes/${volume} ")
      list(APPEND temp_roots "/Volumes/${volume}/tmp")
    endif()
  endforeach()
  if(NOT temp_roots)
    message(FATAL_ERROR "Mac qualification needs mounted S8T or PRO-BLADE; use a configured self-hosted Mac runner or local evidence. System temporary storage is forbidden.")
  endif()
  if(NOT DEFINED QUALIFICATION_OUTPUT)
    list(GET temp_roots 0 temp_root)
    string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
    string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
    set(QUALIFICATION_OUTPUT "${temp_root}/ck-core-fs-qualification-${stamp}-${suffix}")
  endif()
  set(allowed FALSE)
  foreach(temp_root IN LISTS temp_roots)
    cmake_path(IS_PREFIX temp_root "${QUALIFICATION_OUTPUT}" NORMALIZE matches_root)
    if(matches_root)
      set(allowed TRUE)
    endif()
  endforeach()
  if(NOT allowed)
    message(FATAL_ERROR "Mac QUALIFICATION_OUTPUT must be beneath a mounted S8T/tmp or PRO-BLADE/tmp")
  endif()
endif()
if(NOT IS_ABSOLUTE "${QUALIFICATION_OUTPUT}" OR EXISTS "${QUALIFICATION_OUTPUT}")
  message(FATAL_ERROR "QUALIFICATION_OUTPUT must be a fresh absolute directory")
endif()
cmake_path(IS_PREFIX source "${QUALIFICATION_OUTPUT}" NORMALIZE inside_source)
if(inside_source)
  message(FATAL_ERROR "Keep qualification output outside the source tree")
endif()
if(NOT DEFINED QUALIFICATION_BROWSER)
  set(QUALIFICATION_BROWSER ON)
endif()
if(NOT DEFINED QUALIFICATION_SANITIZER)
  set(QUALIFICATION_SANITIZER none)
endif()
set(config RelWithDebInfo)
file(MAKE_DIRECTORY "${QUALIFICATION_OUTPUT}/tmp")
set(ENV{TMPDIR} "${QUALIFICATION_OUTPUT}/tmp")
set(ENV{TMP} "$ENV{TMPDIR}")
set(ENV{TEMP} "$ENV{TMPDIR}")
set(ENV{CTEST_PARALLEL_LEVEL} 1)
set(log "${QUALIFICATION_OUTPUT}/qualification.log")
function(record line)
  message(STATUS "${line}")
  file(APPEND "${log}" "${line}\n")
endfunction()
function(fingerprint output)
  file(GLOB_RECURSE inputs RELATIVE "${source}" LIST_DIRECTORIES false
    "${source}/src/*" "${source}/include/*" "${source}/tests/*"
    "${source}/cmake/*" "${source}/tools/*" "${source}/.github/workflows/*")
  list(APPEND inputs CMakeLists.txt)
  list(SORT inputs)
  set(manifest "")
  foreach(input IN LISTS inputs)
    file(SHA256 "${source}/${input}" hash)
    string(APPEND manifest "${hash}  ${input}\n")
  endforeach()
  string(SHA256 hash "${manifest}")
  set(${output} "${hash}" PARENT_SCOPE)
  file(WRITE "${QUALIFICATION_OUTPUT}/source-${hash}.sha256" "${manifest}")
endfunction()
function(run stage)
  string(TIMESTAMP started "%Y-%m-%dT%H:%M:%SZ" UTC)
  string(TIMESTAMP begin "%s" UTC)
  record("${stage} start=${started} config=${config} output=${QUALIFICATION_OUTPUT} command=${ARGN}")
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE result)
  string(TIMESTAMP ended "%Y-%m-%dT%H:%M:%SZ" UTC)
  string(TIMESTAMP end "%s" UTC)
  math(EXPR elapsed "${end} - ${begin}")
  record("${stage} end=${ended} elapsed_seconds=${elapsed} result=${result}")
  if(stage STREQUAL "test")
    # CTest has exited, including all workers. Keep Testing/Temporary logs,
    # release only this fresh qualification's explicitly bounded fixture root.
    file(REMOVE_RECURSE "${QUALIFICATION_OUTPUT}/build/tasks")
  endif()
  if(NOT "${result}" STREQUAL "0")
    record("qualification FAILED stage=${stage}")
    message(FATAL_ERROR "${stage} failed: ${result}; evidence: ${log}")
  endif()
endfunction()
fingerprint(initial)
string(TIMESTAMP started "%Y-%m-%dT%H:%M:%SZ" UTC)
string(TIMESTAMP begin "%s" UTC)
record("qualification start=${started} source=${source} source_sha256=${initial} output=${QUALIFICATION_OUTPUT} config=${config} browser=${QUALIFICATION_BROWSER} sanitizer=${QUALIFICATION_SANITIZER} parallel=1")
record("Duration baseline: unavailable on a fresh runner; inspect build commands and source manifest, not elapsed time alone. Assets: no separate bundled assets.")
set(flags "")
if(QUALIFICATION_SANITIZER STREQUAL "address-undefined")
  set(flags "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer")
elseif(QUALIFICATION_SANITIZER STREQUAL "thread")
  set(flags "-fsanitize=thread -fno-sanitize-recover=all -fno-omit-frame-pointer")
elseif(NOT QUALIFICATION_SANITIZER STREQUAL "none")
  message(FATAL_ERROR "Unknown sanitizer: ${QUALIFICATION_SANITIZER}")
endif()
set(options "-DCMAKE_BUILD_TYPE=${config}" "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON")
if(flags)
  # Global flags reach engine, platform, browser, C ABI, and test translation units.
  list(APPEND options "-DCMAKE_C_FLAGS=${flags}" "-DCMAKE_CXX_FLAGS=${flags}"
    "-DCMAKE_EXE_LINKER_FLAGS=${flags}" "-DCMAKE_SHARED_LINKER_FLAGS=${flags}")
endif()
set(build "${QUALIFICATION_OUTPUT}/build")
run(configure "${CMAKE_COMMAND}" -S "${source}" -B "${build}"
  -DBUILD_TESTING=ON "-DCK_CORE_FS_BUILD_BROWSER=${QUALIFICATION_BROWSER}" ${options})
if(flags)
  file(READ "${build}/compile_commands.json" commands)
  string(JSON count LENGTH "${commands}")
  math(EXPR last "${count} - 1")
  foreach(index RANGE ${last})
    string(JSON command GET "${commands}" ${index} command)
    if(NOT command MATCHES "${flags}" OR command MATCHES "-fno-sanitize=|sanitize-ignorelist|sanitize-blacklist")
      message(FATAL_ERROR "Missing instrumentation or sanitizer exclusion: ${command}")
    endif()
  endforeach()
  record("Verified sanitizer flags on all ${count} translation units; no exclusions.")
endif()
execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${build}" -C "${config}" --show-only=json-v1
  OUTPUT_VARIABLE test_inventory RESULT_VARIABLE inventory_result)
if(NOT inventory_result EQUAL 0 OR NOT test_inventory MATCHES "job_lifecycle")
  message(FATAL_ERROR "Qualification requires a registered job_lifecycle CTest with an explicit build/tasks root")
endif()
run(build "${CMAKE_COMMAND}" --build "${build}" --config "${config}" --parallel 1 --verbose)
run(test "${CMAKE_CTEST_COMMAND}" --test-dir "${build}" -C "${config}"
  --output-on-failure --no-tests=error --parallel 1 --timeout 180)
set(prefix "${QUALIFICATION_OUTPUT}/install")
run(install "${CMAKE_COMMAND}" --install "${build}" --config "${config}" --prefix "${prefix}")
set(consumer "${QUALIFICATION_OUTPUT}/consumer")
run(consumer-configure "${CMAKE_COMMAND}" -S "${source}/tests/consumer" -B "${consumer}"
  "-DCMAKE_PREFIX_PATH=${prefix}" ${options})
run(consumer-build "${CMAKE_COMMAND}" --build "${consumer}" --config "${config}" --parallel 1 --verbose)
# Windows DLL resolution uses the installed bin directory, not the build tree.
if(CMAKE_HOST_WIN32)
  set(ENV{PATH} "${prefix}/bin;$ENV{PATH}")
endif()
run(consumer-test "${CMAKE_CTEST_COMMAND}" --test-dir "${consumer}" -C "${config}"
  --output-on-failure --no-tests=error --parallel 1 --timeout 60 -R "^installed_c_consumer$")
fingerprint(final)
if(NOT initial STREQUAL final)
  message(FATAL_ERROR "Sources changed during qualification: ${initial} -> ${final}; rerun")
endif()
string(TIMESTAMP ended "%Y-%m-%dT%H:%M:%SZ" UTC)
string(TIMESTAMP end "%s" UTC)
math(EXPR elapsed "${end} - ${begin}")
record("qualification PASS start=${started} end=${ended} elapsed_seconds=${elapsed} source_sha256=${final} output=${QUALIFICATION_OUTPUT} config=${config}")
