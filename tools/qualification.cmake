# Run with cmake -DQUALIFICATION_OUTPUT=<fresh absolute directory> -P tools/qualification.cmake.
cmake_minimum_required(VERSION 3.25)
get_filename_component(source "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(CMAKE_HOST_APPLE)
  execute_process(COMMAND /sbin/mount OUTPUT_VARIABLE mounts COMMAND_ERROR_IS_FATAL ANY)
  set(temp_roots "")
  foreach(volume S8T PRO-BLADE)
    if(mounts MATCHES " on /Volumes/${volume} ")
      list(APPEND temp_roots "/Volumes/${volume}/tmp")
    endif()
  endforeach()
  if(NOT temp_roots)
    message(FATAL_ERROR "Mac qualification needs mounted S8T or PRO-BLADE; use a configured self-hosted Mac runner or local evidence. System temporary storage is forbidden.")
  endif()
  if(NOT DEFINED QUALIFICATION_OUTPUT)
    list(GET temp_roots 0 temp_root)
    string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
    string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
    set(QUALIFICATION_OUTPUT "${temp_root}/ck-core-fs-qualification-${stamp}-${suffix}")
  endif()
  set(allowed FALSE)
  foreach(temp_root IN LISTS temp_roots)
    cmake_path(IS_PREFIX temp_root "${QUALIFICATION_OUTPUT}" NORMALIZE matches_root)
    if(matches_root)
      set(allowed TRUE)
    endif()
  endforeach()
  if(NOT allowed)
    message(FATAL_ERROR "Mac QUALIFICATION_OUTPUT must be beneath a mounted S8T/tmp or PRO-BLADE/tmp")
  endif()
endif()
if(NOT IS_ABSOLUTE "${QUALIFICATION_OUTPUT}" OR EXISTS "${QUALIFICATION_OUTPUT}")
  message(FATAL_ERROR "QUALIFICATION_OUTPUT must be a fresh absolute directory")
endif()
cmake_path(IS_PREFIX source "${QUALIFICATION_OUTPUT}" NORMALIZE inside_source)
if(inside_source)
  message(FATAL_ERROR "Keep qualification output outside the source tree")
endif()
if(NOT DEFINED QUALIFICATION_BROWSER)
  set(QUALIFICATION_BROWSER ON)
endif()
if(NOT DEFINED QUALIFICATION_SANITIZER)
  set(QUALIFICATION_SANITIZER none)
endif()
set(config RelWithDebInfo)
if(CMAKE_HOST_WIN32)
  if(NOT DEFINED QUALIFICATION_WINDOWS_TEST_FS OR
      NOT QUALIFICATION_WINDOWS_TEST_FS MATCHES "^(NTFS|ReFS)$")
    message(FATAL_ERROR "Windows qualification requires explicit QUALIFICATION_WINDOWS_TEST_FS=NTFS or ReFS; no default provider")
  endif()
  if(NOT DEFINED QUALIFICATION_NATIVE_TEST_ROOT OR NOT IS_ABSOLUTE "${QUALIFICATION_NATIVE_TEST_ROOT}")
    message(FATAL_ERROR "Select the actual Windows fixture root explicitly with QUALIFICATION_NATIVE_TEST_ROOT")
  endif()
  # Workstation launchers opt into the mandatory development-drive policy.
  # Hosted Windows uses its controlled absolute runner temporary storage.
  if("$ENV{CK_FS_REQUIRE_V_DEV_DRIVE}" STREQUAL "1")
    if(NOT EXISTS "V:/")
      message(FATAL_ERROR "Windows workstation development drive V: is unavailable")
    endif()
    foreach(key QUALIFICATION_OUTPUT QUALIFICATION_NATIVE_TEST_ROOT)
      # Lexical policy key only: retain ${key}'s native spelling for I/O.
      string(REPLACE "\\" "/" native_path "${${key}}")
      if(native_path MATCHES "^//[?]/[A-Za-z]:/")
        string(SUBSTRING "${native_path}" 4 -1 native_path)
      endif()
      if(NOT native_path MATCHES "^[A-Za-z]:/" OR
          native_path MATCHES "(^|/)[.][.]?(/|$)" OR
          native_path MATCHES ";")
        message(FATAL_ERROR "${key} must be an unambiguous absolute DOS address beneath V:/tmp")
      endif()
      string(SUBSTRING "${native_path}" 3 -1 native_tail)
      if(native_tail MATCHES ":")
        message(FATAL_ERROR "${key} must not contain an alternate-stream component")
      endif()
      string(TOLOWER "${native_path}" native_path)
      cmake_path(NORMAL_PATH native_path)
      set(dev_tmp "v:/tmp")
      cmake_path(IS_PREFIX dev_tmp "${native_path}" NORMALIZE on_dev_tmp)
      if(NOT on_dev_tmp OR native_path MATCHES "^v:/tmp/?$")
        message(FATAL_ERROR "Workstation qualification outputs and fixtures must be under V:/tmp")
      endif()
    endforeach()
  endif()
  foreach(key CK_CORE_FS_ARCHIVE_TEST_FS CK_CORE_FS_METADATA_TARGET_NATIVE_FS)
    if(DEFINED ${key} AND NOT "${${key}}" STREQUAL "${QUALIFICATION_WINDOWS_TEST_FS}")
      message(FATAL_ERROR "Conflicting ${key}; select one actual Windows fixture provider")
    endif()
  endforeach()
endif()
if(CMAKE_HOST_WIN32)
  # Admit output ancestry before any output write, including fresh leaves.
  # Explicit fixture addresses may name mounted volumes; they are not provider
  # authority. Native fixtures independently acquire/qualify their held root.
  find_program(qualification_pwsh NAMES pwsh REQUIRED)
  execute_process(COMMAND "${qualification_pwsh}" -NoLogo -NoProfile -NonInteractive
    -File "${CMAKE_CURRENT_LIST_DIR}/windows_fixture_provider.ps1"
    -FixtureRoot "${QUALIFICATION_NATIVE_TEST_ROOT}" -Report "${QUALIFICATION_OUTPUT}"
    -ValidatePathsOnly RESULT_VARIABLE path_guard_result
    OUTPUT_VARIABLE path_guard_output ERROR_VARIABLE path_guard_error)
  if(NOT path_guard_result EQUAL 0)
    message(FATAL_ERROR "Windows qualification path admission failed: ${path_guard_error}")
  endif()
endif()

file(MAKE_DIRECTORY "${QUALIFICATION_OUTPUT}/tmp")
set(ENV{TMPDIR} "${QUALIFICATION_OUTPUT}/tmp")
set(ENV{TMP} "$ENV{TMPDIR}")
set(ENV{TEMP} "$ENV{TMPDIR}")
set(ENV{CTEST_PARALLEL_LEVEL} 1)
set(log "${QUALIFICATION_OUTPUT}/qualification.log")
function(record line)
  message(STATUS "${line}")
  file(APPEND "${log}" "${line}\n")
endfunction()
function(fingerprint output)
  file(GLOB_RECURSE inputs RELATIVE "${source}" LIST_DIRECTORIES false
    "${source}/src/*" "${source}/include/*" "${source}/tests/*"
    "${source}/cmake/*" "${source}/tools/*" "${source}/.github/workflows/*")
  list(APPEND inputs CMakeLists.txt)
  list(SORT inputs)
  set(manifest "")
  foreach(input IN LISTS inputs)
    file(SHA256 "${source}/${input}" hash)
    string(APPEND manifest "${hash}  ${input}\n")
  endforeach()
  string(SHA256 hash "${manifest}")
  set(${output} "${hash}" PARENT_SCOPE)
  file(WRITE "${QUALIFICATION_OUTPUT}/source-${hash}.sha256" "${manifest}")
endfunction()
function(run stage)
  string(TIMESTAMP started "%Y-%m-%dT%H:%M:%SZ" UTC)
  string(TIMESTAMP begin "%s" UTC)
  record("${stage} start=${started} config=${config} output=${QUALIFICATION_OUTPUT} command=${ARGN}")
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE result)
  string(TIMESTAMP ended "%Y-%m-%dT%H:%M:%SZ" UTC)
  string(TIMESTAMP end "%s" UTC)
  math(EXPR elapsed "${end} - ${begin}")
  record("${stage} end=${ended} elapsed_seconds=${elapsed} result=${result}")
  if(stage STREQUAL "test" AND "${result}" STREQUAL "0")
    # CTest has exited, including all workers. Keep Testing/Temporary logs,
    # release only this fresh qualification's explicitly bounded fixture root.
    file(REMOVE_RECURSE "${QUALIFICATION_OUTPUT}/build/tasks")
  endif()
  if(NOT "${result}" STREQUAL "0")
    record("qualification FAILED stage=${stage}")
    message(FATAL_ERROR "${stage} failed: ${result}; evidence: ${log}")
  endif()
endfunction()
fingerprint(initial)
string(TIMESTAMP started "%Y-%m-%dT%H:%M:%SZ" UTC)
string(TIMESTAMP begin "%s" UTC)
record("qualification start=${started} source=${source} source_sha256=${initial} output=${QUALIFICATION_OUTPUT} config=${config} browser=${QUALIFICATION_BROWSER} sanitizer=${QUALIFICATION_SANITIZER} parallel=1")
record("Duration baseline: unavailable on a fresh runner; inspect build commands and source manifest, not elapsed time alone. Assets: no separate bundled assets.")
set(flags "")
if(QUALIFICATION_SANITIZER STREQUAL "address-undefined")
  set(flags "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer")
elseif(QUALIFICATION_SANITIZER STREQUAL "thread")
  set(flags "-fsanitize=thread -fno-sanitize-recover=all -fno-omit-frame-pointer")
elseif(NOT QUALIFICATION_SANITIZER STREQUAL "none")
  message(FATAL_ERROR "Unknown sanitizer: ${QUALIFICATION_SANITIZER}")
endif()
set(options "-DCMAKE_BUILD_TYPE=${config}" "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON")
if(QUALIFICATION_SHARED_THREAD_RUNTIME)
  if(NOT QUALIFICATION_SANITIZER STREQUAL "thread" OR NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "Shared thread runtime selection is supported for Linux TSan qualification")
  endif()
  if(NOT DEFINED ENV{CXX} OR "$ENV{CXX}" STREQUAL "")
    message(FATAL_ERROR "Select the matching Clang CXX compiler explicitly")
  endif()
  find_program(thread_compiler NAMES "$ENV{CXX}" REQUIRED NO_CACHE)
  execute_process(COMMAND "${thread_compiler}" --version OUTPUT_VARIABLE compiler_version RESULT_VARIABLE compiler_result)
  if(NOT compiler_result EQUAL 0 OR NOT compiler_version MATCHES "clang version")
    message(FATAL_ERROR "Shared compiler-rt qualification requires the selected Clang compiler")
  endif()
  execute_process(COMMAND "${thread_compiler}" -dumpmachine OUTPUT_VARIABLE compiler_target OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  string(REGEX MATCH "^[^-]+" runtime_arch "${compiler_target}")
  execute_process(COMMAND "${thread_compiler}" "-print-file-name=libclang_rt.tsan-${runtime_arch}.so"
    OUTPUT_VARIABLE thread_runtime OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  if(NOT IS_ABSOLUTE "${thread_runtime}" OR NOT EXISTS "${thread_runtime}")
    message(FATAL_ERROR "The selected compiler's matching shared TSan runtime is unavailable: ${thread_runtime}")
  endif()
  file(REAL_PATH "${thread_runtime}" thread_runtime)
  file(SHA256 "${thread_runtime}" thread_runtime_hash)
  get_filename_component(thread_runtime_directory "${thread_runtime}" DIRECTORY)
  string(APPEND flags " -shared-libsan")
  list(APPEND options "-DCMAKE_BUILD_RPATH=${thread_runtime_directory}"
    "-DCMAKE_INSTALL_RPATH=${thread_runtime_directory}" "-DCK_CORE_FS_SHARED_TSAN_RUNTIME=${thread_runtime}")
  record("Matching shared TSan runtime=${thread_runtime} sha256=${thread_runtime_hash} compiler=${thread_compiler} target=${compiler_target}; all implementation/test/consumer TUs retain full instrumentation; allocator and deliberate-race controls required.")
endif()
if(DEFINED QUALIFICATION_NATIVE_TEST_ROOT)
  if(NOT IS_ABSOLUTE "${QUALIFICATION_NATIVE_TEST_ROOT}")
    message(FATAL_ERROR "QUALIFICATION_NATIVE_TEST_ROOT must be absolute")
  endif()
  if(CMAKE_HOST_APPLE)
    set(allowed_native FALSE)
    foreach(temp_root IN LISTS temp_roots)
      cmake_path(IS_PREFIX temp_root "${QUALIFICATION_NATIVE_TEST_ROOT}" NORMALIZE matches_root)
      if(matches_root)
        set(allowed_native TRUE)
      endif()
    endforeach()
    if(NOT allowed_native)
      message(FATAL_ERROR "Mac native fixtures must remain below a mounted approved temporary root")
    endif()
  endif()
  list(APPEND options "-DCK_CORE_FS_NATIVE_TEST_ROOT=${QUALIFICATION_NATIVE_TEST_ROOT}")
  record("Native fixtures=${QUALIFICATION_NATIVE_TEST_ROOT}; provider semantics are qualified separately from the build volume. External fixture root is not recursively removed by this helper.")
endif()
if(flags)
  # Global flags reach engine, platform, browser, C ABI, and test translation units.
  list(APPEND options "-DCMAKE_C_FLAGS=${flags}" "-DCMAKE_CXX_FLAGS=${flags}"
    "-DCMAKE_EXE_LINKER_FLAGS=${flags}" "-DCMAKE_SHARED_LINKER_FLAGS=${flags}")
endif()
if(CMAKE_HOST_WIN32)
  find_program(qualification_python NAMES python python3 REQUIRED)
  run(windows-source-preflight "${qualification_python}" "${source}/tools/check_windows_runtime_hooks.py"
    --source "${source}" --report "${QUALIFICATION_OUTPUT}/windows-hook-preflight.json")
  list(APPEND options "-DCK_CORE_FS_ARCHIVE_TEST_FS=${QUALIFICATION_WINDOWS_TEST_FS}"
    "-DCK_CORE_FS_METADATA_TARGET_NATIVE_FS=${QUALIFICATION_WINDOWS_TEST_FS}")
  record("Windows expected fixture provider=${QUALIFICATION_WINDOWS_TEST_FS}; archive and metadata targets receive the same explicit value; native held-provider preflight remains independent.")
endif()
set(build "${QUALIFICATION_OUTPUT}/build")
run(configure "${CMAKE_COMMAND}" -S "${source}" -B "${build}"
  -DBUILD_TESTING=ON "-DCK_CORE_FS_BUILD_BROWSER=${QUALIFICATION_BROWSER}" ${options})
if(flags)
  file(READ "${build}/compile_commands.json" commands)
  string(JSON count LENGTH "${commands}")
  math(EXPR last "${count} - 1")
  foreach(index RANGE ${last})
    string(JSON command GET "${commands}" ${index} command)
    if(NOT command MATCHES "${flags}" OR command MATCHES "-fno-sanitize=|sanitize-ignorelist|sanitize-blacklist")
      message(FATAL_ERROR "Missing instrumentation or sanitizer exclusion: ${command}")
    endif()
  endforeach()
  record("Verified sanitizer flags on all ${count} translation units; no exclusions.")
endif()
execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${build}" -C "${config}" --show-only=json-v1
  OUTPUT_VARIABLE test_inventory RESULT_VARIABLE inventory_result)
if(NOT inventory_result EQUAL 0 OR NOT test_inventory MATCHES "job_lifecycle")
  message(FATAL_ERROR "Qualification requires a registered job_lifecycle CTest with an explicit native fixture root")
endif()
run(build "${CMAKE_COMMAND}" --build "${build}" --config "${config}" --parallel 1 --verbose)
run(test "${CMAKE_CTEST_COMMAND}" --test-dir "${build}" -C "${config}"
  --output-on-failure --no-tests=error --parallel 1 --timeout 180)
set(prefix "${QUALIFICATION_OUTPUT}/install")
run(install "${CMAKE_COMMAND}" --install "${build}" --config "${config}" --prefix "${prefix}")
set(consumer "${QUALIFICATION_OUTPUT}/consumer")
# This helper always builds the SDK with BUILD_TESTING=ON. Explicitly match
# its private header definitions in controlled installed clients; production
# clients retain the OFF default and SDK targets export no test capabilities.
set(test_producer_options -DCK_CORE_FS_CONSUMER_MATCH_TEST_PRODUCER=ON)
set(consumer_options ${test_producer_options})
record("Installed test clients explicitly match the producer's private testing profile; production OFF prefixes require the default OFF client profile.")
if(flags)
  list(APPEND consumer_options -DCK_CORE_FS_CONSUMER_CXX_LINKER=ON)
  record("Installed consumer remains C11; matching C++ final driver supplies the instrumented C++ backend runtime. Ordinary qualification retains the C-only link gate.")
endif()
run(consumer-configure "${CMAKE_COMMAND}" -S "${source}/tests/consumer" -B "${consumer}"
  "-DCMAKE_PREFIX_PATH=${prefix}" ${options} ${consumer_options})
run(consumer-build "${CMAKE_COMMAND}" --build "${consumer}" --config "${config}" --parallel 1 --verbose)
# Windows DLL resolution uses the installed bin directory, not the build tree.
if(CMAKE_HOST_WIN32)
  set(ENV{PATH} "${prefix}/bin;$ENV{PATH}")
endif()
run(consumer-test "${CMAKE_CTEST_COMMAND}" --test-dir "${consumer}" -C "${config}"
  --output-on-failure --no-tests=error --parallel 1 --timeout 60 -R "^installed_c_consumer$")
set(layer_consumers "${QUALIFICATION_OUTPUT}/layer-consumers")
set(layer_fixture_root "$ENV{TMPDIR}")
if(DEFINED QUALIFICATION_NATIVE_TEST_ROOT)
  set(layer_fixture_root "${QUALIFICATION_NATIVE_TEST_ROOT}")
endif()
run(layer-consumers-configure "${CMAKE_COMMAND}" -S "${source}/tests/installed_layers" -B "${layer_consumers}"
  "-DCMAKE_PREFIX_PATH=${prefix}" "-DCK_LAYER_FIXTURE_ROOT=${layer_fixture_root}" ${options} ${test_producer_options})
run(layer-consumers-build "${CMAKE_COMMAND}" --build "${layer_consumers}" --config "${config}" --parallel 1 --verbose)
run(layer-consumers-test "${CMAKE_CTEST_COMMAND}" --test-dir "${layer_consumers}" -C "${config}"
  --output-on-failure --no-tests=error --parallel 1 --timeout 90)
fingerprint(final)
if(DEFINED thread_runtime)
  file(SHA256 "${thread_runtime}" final_runtime_hash)
  if(NOT final_runtime_hash STREQUAL thread_runtime_hash)
    message(FATAL_ERROR "The matching sanitizer runtime changed during qualification")
  endif()
endif()
if(NOT initial STREQUAL final)
  message(FATAL_ERROR "Sources changed during qualification: ${initial} -> ${final}; rerun")
endif()
string(TIMESTAMP ended "%Y-%m-%dT%H:%M:%SZ" UTC)
string(TIMESTAMP end "%s" UTC)
math(EXPR elapsed "${end} - ${begin}")
record("qualification PASS start=${started} end=${ended} elapsed_seconds=${elapsed} source_sha256=${final} output=${QUALIFICATION_OUTPUT} config=${config}")
