prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: ck-core-fs-lib
Description: Headless cross-platform filesystem engine with C ABI
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lck-core-fs-lib
Cflags: -I${includedir}
