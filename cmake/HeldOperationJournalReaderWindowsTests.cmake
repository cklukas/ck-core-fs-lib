function(_ck_close_batch_case provider family target timeout)
  set(_close_name "close_batch_windows_${provider}_${family}")
  if(family STREQUAL "seed")
    add_test(NAME "${_close_name}" COMMAND "${Python3_EXECUTABLE}"
      "${CMAKE_CURRENT_SOURCE_DIR}/tests/run_seed_close_fixture_windows.py"
      $<TARGET_FILE:${target}> "${_reader_root_${provider}}" "${provider}" ${ARGN})
  else()
    add_test(NAME "${_close_name}" COMMAND $<TARGET_FILE:${target}> ${ARGN})
  endif()
  set_tests_properties("${_close_name}" PROPERTIES TIMEOUT "${timeout}"
    RUN_SERIAL TRUE PROCESSORS 1 RESOURCE_LOCK ck_core_fs_native_close_serial
    LABELS "windows;native;windows-close-batch;${provider}"
    ENVIRONMENT "TEMP=${_reader_root_${provider}};TMP=${_reader_root_${provider}};TMPDIR=${_reader_root_${provider}}")
endfunction()
