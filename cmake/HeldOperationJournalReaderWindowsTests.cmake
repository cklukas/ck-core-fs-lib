function(_ck_reader_close_case kind provider target mode layout)
  set(_reader_args "${target}" "${mode}" "${layout}" ${ARGN})
  string(JOIN "_" _reader_suffix ${_reader_args})
  set(_reader_name "reader_close_windows_${kind}_${provider}_${_reader_suffix}")
  if(kind STREQUAL "backend")
    set(_reader_binary ck_reader_native_close_tests)
  elseif(kind STREQUAL "worker")
    set(_reader_binary ck_reader_worker_close_tests)
  else()
    message(FATAL_ERROR "Unknown reader close test family")
  endif()
  add_test(NAME "${_reader_name}" COMMAND "${Python3_EXECUTABLE}"
    "${CMAKE_CURRENT_SOURCE_DIR}/tests/run_reader_close_fixture_windows.py"
    $<TARGET_FILE:${_reader_binary}> "${_reader_root_${provider}}"
    "${provider}" ${_reader_args})
  set_tests_properties("${_reader_name}" PROPERTIES TIMEOUT 60 RUN_SERIAL TRUE
    PROCESSORS 1 RESOURCE_LOCK ck_core_fs_native_close_serial
    LABELS "windows;native;journal;reader-close;windows-close-batch;${provider}"
    ENVIRONMENT "TEMP=${_reader_root_${provider}};TMP=${_reader_root_${provider}};TMPDIR=${_reader_root_${provider}}")
  if(mode MATCHES "-oom$")
    set_property(TEST "${_reader_name}" APPEND PROPERTY LABELS allocation-failure)
  endif()
  if("prior" IN_LIST ARGN)
    set_property(TEST "${_reader_name}" APPEND PROPERTY LABELS first-error-contract)
  endif()
endfunction()
